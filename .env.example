# ---------------------------------------------------------------------------
# SeaDex Companion — environment template
#
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and docker-ignored (see .dockerignore).
# NEVER commit real secrets. When you run the stack with `docker compose up`,
# Docker Compose reads ./.env automatically and injects these values into the
# container (see docker-compose.yml).
#
# You can also configure all of these through the web UI (Config tab), which
# persists them to data/config.json (also git-ignored).
# ---------------------------------------------------------------------------

# Sonarr
SONARR_URL=http://<sonarr-host>:8989/api/v3
SONARR_KEY=your-sonarr-api-key

# Radarr
RADARR_URL=http://<radarr-host>:7878/api/v3
RADARR_KEY=your-radarr-api-key

# qBittorrent
QBITTORRENT_URL=http://<qbittorrent-host>:8080
QBITTORRENT_USER=your-qbittorrent-username
QBITTORRENT_PASS=your-qbittorrent-password

# Discord webhook (optional — leave empty to disable notifications)
DISCORD_WEBHOOK=