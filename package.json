{
  "name": "seadex-companion",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm --prefix frontend run build",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx watch server/index.ts",
    "prestart": "npm run build",
    "start": "node dist/server/index.js",
    "test": "npm run build:server && node --test --experimental-test-isolation=none dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix frontend run build -- --emptyOutDir=false"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "^4.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1"
  }
}
