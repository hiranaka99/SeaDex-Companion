#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# push-dockerhub.sh — Build SeaDex Companion and push it to Docker Hub (Linux/macOS)
#
# Prerequisites:
#   - Docker running
#   - Logged in to Docker Hub:  docker login
#
# Usage:
#   ./scripts/push-dockerhub.sh your-dockerhub-username
#   ./scripts/push-dockerhub.sh your-dockerhub-username "latest,1.0.0"
#
# The image is always additionally tagged with the current git short SHA so
# every push is traceable back to a commit.
# -----------------------------------------------------------------------------
set -euo pipefail

USER="${1:?Usage: $0 <dockerhub-username> [tags]}"
TAGS="${2:-latest}"
REPO="docker.io/${USER}/seadex-companion"

echo "==> Building ${REPO} ..."
docker build -t "${REPO}:build" .

IFS=',' read -ra TAG_LIST <<< "${TAGS}"

# Add the git short SHA tag for traceability
if command -v git >/dev/null 2>&1; then
  SHA="$(git rev-parse --short HEAD 2>/dev/null || true)"
  [ -n "${SHA}" ] && TAG_LIST+=("${SHA}")
fi

for t in "${TAG_LIST[@]}"; do
  t="$(echo "${t}" | xargs)"   # trim whitespace
  [ -z "${t}" ] && continue
  docker tag "${REPO}:build" "${REPO}:${t}"
  echo "==> Pushing ${REPO}:${t} ..."
  docker push "${REPO}:${t}"
done

docker rmi "${REPO}:build" >/dev/null 2>&1 || true

echo ""
echo "Done! Pull it anywhere with:"
echo "  docker pull ${REPO}:${TAG_LIST[0]}"